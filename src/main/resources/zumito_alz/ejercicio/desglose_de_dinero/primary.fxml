<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="330.0" prefWidth="420.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="zumito_alz.ejercicio.desglose_de_dinero.PrimaryController">
   <children>
      <HBox>
         <children>
             
            <Label text="Dinero:" />
            <TextField fx:id="txtDinero" />
            <Button fx:id="btn_desglosar" onAction="#btn_Desglosar_click" text="Desglosar" />
            <Button fx:id="btn_Limpiar" onAction="#btn_limpiar_click" text="X" />
         </children>
      </HBox>
      <HBox>
         <children>
            <TextArea fx:id="txtA_billetes" nodeOrientation="RIGHT_TO_LEFT" prefHeight="182.0" prefWidth="155.0" text="Billetes de $500&#10;Billetes de $200&#10;Billetes de $100&#10;Billetes de $50&#10;Billetes de $20&#10;Monedas de $10&#10;Monedas de $5&#10;Monedas de $2&#10;Monedas de $1" />
            <TextArea fx:id="txtA_cantidad" prefHeight="200.0" prefWidth="198.0" />
         </children>
      </HBox>
      
         </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
